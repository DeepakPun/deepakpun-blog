---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Header from "../components/Header.astro";

type Props = CollectionEntry<"blog">["data"];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<html lang={Astro.url.pathname.includes("/blog/ne/") ? "ne" : "en"}>
  <head>
    <BaseHead title={title} description={description} />
    <style>
      /* Creates the side-by-side split layout */
      .hero-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 3rem;
        margin-bottom: 2rem;
      }

      /* Allows the title text area to expand and fill space */
      .title-section {
        flex: 1;
        text-align: left;
      }

      .title-section h1 {
        margin: 0 0 0.5rem 0;
        font-size: 2.5rem;
        line-height: 1.2;
      }

      /* Restricts and shrinks the hero image so it fits neatly on the right */
      .hero-image-side {
        flex-shrink: 0;
        width: 300px;
      }

      .hero-image-side img {
        display: block;
        width: 100%;
        height: auto;
        border-radius: 12px;
        box-shadow: var(--box-shadow);
      }

      /* Styles the language toggle wrapper */
      .language-toggle-container {
        margin: 1rem 0 2rem 0;
        display: flex;
        justify-content: flex-end;
      }

      .lang-toggle-link {
        font-size: 0.9rem;
        font-weight: 500;
        text-decoration: none;
        color: var(--accent, #3273dc);
        padding: 0.4rem 0.8rem;
        border: 1px solid currentColor;
        border-radius: 6px;
        transition: background-color 0.2s ease;
      }

      .lang-toggle-link:hover {
        background-color: rgba(50, 115, 220, 0.1);
      }

      /* Responsive layout: stacks them on top of each other on mobile screens */
      @media (max-width: 768px) {
        .hero-row {
          flex-direction: column-reverse;
          gap: 1.5rem;
        }
        .hero-image-side {
          width: 100%;
        }
        .title-section {
          text-align: center;
        }
        .language-toggle-container {
          justify-content: center;
        }
      }
    </style>
  </head>

  <body>
    <Header />
    <main>
      <article>
        <!-- Cleaned Up Language Toggle Link -->
        <div class="language-toggle-container">
          {
            Astro.url.pathname.includes("/blog/ne/") ? (
              <a
                href={Astro.url.pathname.replace("/blog/ne/", "/blog/en/")}
                class="lang-toggle-link"
              >
                🌐 Read in English
              </a>
            ) : (
              <a
                href={Astro.url.pathname.replace("/blog/en/", "/blog/ne/")}
                class="lang-toggle-link"
              >
                🌐 नेपालीमा पढ्नुहोस् (Read in Nepali)
              </a>
            )
          }
        </div>

        <div class="hero-row">
          <div class="title-section">
            <div class="date">
              <FormattedDate date={pubDate} />
              {
                updatedDate && (
                  <div class="last-updated-on">
                    Last updated on <FormattedDate date={updatedDate} />
                  </div>
                )
              }
            </div>
            <h1>{title}</h1>
            <hr />
          </div>

          {
            heroImage && (
              <div class="hero-image-side">
                <Image src={heroImage} alt="" />
              </div>
            )
          }
        </div>

        <div class="prose">
          <slot />
        </div>
      </article>
    </main>

    <Footer />
  </body>
</html>
