---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body class="site-wrapper">
    <Header />
    <main class="main-content">
      <h1>🧑‍🚀 Hello, from my blog!</h1>
      <p>
        Hi, I'm Deepak. This is an isolated, minimal blog space where I publish
        quick updates about my projects, microservices app setups, and general
        technical notes.
      </p>
      <p>
        Everything here is written in raw Markdown and deployed instantly via
        Astro and Vercel. Click the blog link above to view latest posts.
      </p>
    </main>
    <Footer />
  </body>
</html>

<style>
  .site-wrapper {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    margin: 0;
  }
  .main-content {
    flex: 1;
    /* width: 960px;
    max-width: 100%;
    margin: 0 auto;
    padding: 0 1rem; */
  }
