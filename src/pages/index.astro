---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main>
      <h1>🧑‍🚀 Hello, from my blog!</h1>
      <p>
        Hi, I'm Deepak. This is an isolated, minimal blog space where I publish
        quick updates about my projects, microservices app setups, and general
        technical notes.
      </p>
      <p>
        Everything here is written in raw Markdown and deployed instantly via
        Astro and Vercel. Click the blog link above to view latest posts.
      </p>
    </main>
    <Footer />
  </body>
</html>
