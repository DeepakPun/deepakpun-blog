---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Header from "../components/Header.astro";

type Props = CollectionEntry<"blog">["data"];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
    <style>
      /* Creates the side-by-side split layout */
      .hero-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 3rem;
        margin-bottom: 2rem;
      }

      /* Allows the title text area to expand and fill space */
      .title-section {
        flex: 1;
        text-align: left; /* Changes template default centered text to clean left-aligned */
      }

      .title-section h1 {
        margin: 0 0 0.5rem 0;
        font-size: 2.5rem;
        line-height: 1.2;
      }

      /* Restricts and shrinks the hero image so it fits neatly on the right */
      .hero-image-side {
        flex-shrink: 0;
        width: 300px; /* Tweak this value to make the post image smaller or larger */
      }

      .hero-image-side img {
        display: block;
        width: 100%;
        height: auto;
        border-radius: 12px;
        box-shadow: var(--box-shadow);
      }

      /* Responsive layout: stacks them on top of each other on mobile screens */
      @media (max-width: 768px) {
        .hero-row {
          flex-direction: column-reverse; /* Puts image on top, title below on mobile */
          gap: 1.5rem;
        }
        .hero-image-side {
          width: 100%; /* Expands to full width on small screens */
        }
        .title-section {
          text-align: center; /* Reverts to centered on mobile if preferred */
        }
      }
    </style>
  </head>

  <body>
    <Header />
    <main>
      <article>
        <!-- Highlight-start: Add this wrapper around your header assets -->
        <div class="hero-row">
          <div class="title-section">
            <div class="date">
              <FormattedDate date={pubDate} />
              {
                updatedDate && (
                  <div class="last-updated-on">
                    Last updated on <FormattedDate date={updatedDate} />
                  </div>
                )
              }
            </div>
            <h1>{title}</h1>
            <hr />
          </div>

          {
            heroImage && (
              <div class="hero-image-side">
                <Image src={heroImage} alt="" />
              </div>
            )
          }
        </div>
        <!-- Highlight-end -->

        <div class="prose">
          <slot />
        </div>
      </article>
    </main>
    <Footer />
  </body>
</html>
